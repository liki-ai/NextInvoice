# Copy this file to .env and fill in your real keys. Never commit .env.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5-mini
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Postgres. Required in production: on Render the server refuses to start without it,
# because the local disk is rebuilt on every deploy and every account would be lost.
# Leave empty on your own machine to keep data in server/data/db.json.
DATABASE_URL=

# Password-reset emails (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=Next Invoice <noreply@mynextinvoice.com>
# Set MAIL_DEV=1 to return the reset link in the API response (local only)
MAIL_DEV=0

# Invoice emails go out through each company's own mailbox (set up in the app, Settings → Email).
# The saved mailbox passwords are encrypted with a key derived from MAIL_SECRET, or JWT_SECRET when unset.
MAIL_SECRET=
# A browser for printing the invoice PDF that is attached; found automatically in the Docker image.
CHROMIUM_PATH=

# Public web app URL (used for Stripe success/cancel + portal return)
APP_URL=https://mynextinvoice.com

# Stripe (web subscriptions — €20 / month Price ID)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Apple IAP (App Store Connect → shared secret)
APPLE_SHARED_SECRET=

# Google Play IAP (service account JSON as a single line)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.lirim123.nextinvoice

# Comma-separated subscription product ids
IAP_PRODUCT_IDS=nextinvoice_premium_monthly

# Set to 1 only for local testing without Stripe/IAP
BILLING_ALLOW_MOCK=0

# Recurring invoices and scheduled emails run inside the API every 10 minutes.
# AUTOMATION=off stops them (for a second copy of the API, for example).
AUTOMATION=
# Where Stripe reaches this API, shown to companies as their webhook address.
PUBLIC_API_URL=https://api.mynextinvoice.com
